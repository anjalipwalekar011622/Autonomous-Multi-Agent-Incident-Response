# Configuration for Autonomous Multi-Agent Incident Response

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# External Services (Optional)
OLLAMA_API_URL=http://localhost:11434/api/generate

# Thresholds
FAILED_LOGIN_THRESHOLD=5

# ChromaDB Settings
# DB is stored project-relative to avoid hardcoded absolute paths
CHROMA_PERSIST_DIR=./chroma_db
